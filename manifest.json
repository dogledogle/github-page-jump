{
  "manifest_version": 3,
  "name": "GitHub Page Jump",
  "version": "1.3.0",
  "description": "Adds first-page, last-page, and direct page-jump controls to GitHub pagination.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "GitHub Page Jump",
    "default_popup": "src/popup.html"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "css": ["src/content.css"],
      "js": ["src/core.js", "src/shared.js", "src/pagination.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
